// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id
  name                String
  username            String?             @unique
  email               String              @unique
  clerkSubjectId      String?             @unique
  emailVerified       Boolean             @default(false)
  image               String?
  phone               String?
  currency            String              @default("USD")
  theme               String              @default("system")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sessions            Session[]
  accounts            Account[]
  user1Friendships    Friendship[]        @relation("FriendshipUser1")
  user2Friendships    Friendship[]        @relation("FriendshipUser2")
  groupMembers        GroupMember[]       @relation("GroupMembership")
  expensesCreated     Expense[]           @relation("ExpenseCreator")
  expenseSplits       ExpenseSplit[]      @relation("UserSplits")
  settlementsPaid     Settlement[]        @relation("SettlementPayer")
  settlementsReceived Settlement[]        @relation("SettlementPayee")
  settlementActions   Settlement[]        @relation("SettlementActor")
  notifications       Notification[]      @relation("UserNotifications")
  activities          Activity[]          @relation("UserActivities")
  expensePayments     ExpensePayment[]
  expenseRevisions    ExpenseRevision[]   @relation("ExpenseRevisionActor")
  idempotencyRecords  IdempotencyRecord[]
  Receipt             Receipt[]
  PushSubscription    PushSubscription[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Friendship {
  id        String           @id @default(cuid())
  user1Id   String
  user2Id   String
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user1 User @relation("FriendshipUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("FriendshipUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  currency    String   @default("USD")
  inviteLink  String?  @unique
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  activities  Activity[]
  Receipt     Receipt[]
}

model GroupMember {
  id         String    @id @default(cuid())
  groupId    String
  userId     String
  role       GroupRole @default(MEMBER)
  isFavorite Boolean   @default(false)
  createdAt  DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

enum GroupRole {
  ADMIN
  MEMBER
}

model Expense {
  id          String    @id @default(cuid())
  title       String
  description String?
  amount      Float
  totalMinor  BigInt?
  currency    String    @default("USD")
  date        DateTime  @default(now())
  receiptUrl  String?
  notes       String?
  categoryId  String?
  splitType   SplitType @default(EQUAL)
  isRecurring Boolean   @default(false)
  creatorId   String
  groupId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)
  voidedAt    DateTime?

  creator    User              @relation("ExpenseCreator", fields: [creatorId], references: [id])
  group      Group?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category   Category?         @relation(fields: [categoryId], references: [id])
  splits     ExpenseSplit[]
  activities Activity[]
  recurring  RecurringExpense?
  payments   ExpensePayment[]
  revisions  ExpenseRevision[]
  Receipt    Receipt[]

  @@index([creatorId])
  @@index([groupId])
  @@index([categoryId])
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
  CUSTOM
}

model ExpenseSplit {
  id              String  @id @default(cuid())
  expenseId       String
  userId          String
  amountPaid      Float   @default(0)
  amountOwed      Float   @default(0)
  allocationMinor BigInt?
  allocationOrder Int?
  percentageBps   Int?
  shareWeight     BigInt?
  percentage      Float?
  shares          Float?
  expense         Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user            User    @relation("UserSplits", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@unique([expenseId, allocationOrder])
  @@index([userId])
}

model ExpensePayment {
  id                String   @id @default(cuid())
  expenseId         String
  userId            String
  contributionMinor BigInt
  paymentOrder      Int
  createdAt         DateTime @default(now())
  expense           Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
  @@unique([expenseId, paymentOrder])
  @@index([userId])
}

model ExpenseRevision {
  id        String   @id @default(cuid())
  expenseId String
  version   Int
  actorId   String
  snapshot  Json
  createdAt DateTime @default(now())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  actor     User     @relation("ExpenseRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([expenseId, version])
  @@index([actorId])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  actorId     String
  method      String
  route       String
  key         String
  fingerprint String
  statusCode  Int
  response    Json
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, method, route, key])
  @@index([createdAt])
}

model Settlement {
  id          String           @id @default(cuid())
  payerId     String
  payeeId     String
  amount      Float
  amountMinor BigInt?
  currency    String           @default("USD")
  method      PaymentMethod    @default(CASH)
  kind        SettlementKind   @default(PAYMENT)
  date        DateTime         @default(now())
  groupId     String?
  status      SettlementStatus @default(COMPLETED)
  reversesId  String?          @unique
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  payer       User             @relation("SettlementPayer", fields: [payerId], references: [id])
  payee       User             @relation("SettlementPayee", fields: [payeeId], references: [id])
  createdBy   User?            @relation("SettlementActor", fields: [createdById], references: [id], onDelete: Restrict)
  group       Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  reverses    Settlement?      @relation("SettlementReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal    Settlement?      @relation("SettlementReversal")
  activities  Activity[]

  @@index([payerId])
  @@index([payeeId])
  @@index([groupId])
  @@index([createdById])
  @@index([groupId, date, id])
}

enum SettlementKind {
  PAYMENT
  REVERSAL
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

enum SettlementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String?
  color    String?
  expenses Expense[]
}

model RecurringExpense {
  id        String             @id @default(cuid())
  expenseId String             @unique
  frequency RecurringFrequency
  nextDate  DateTime
  endDate   DateTime?
  isActive  Boolean            @default(true)
  expense   Expense            @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationType {
  EXPENSE_ADDED
  SETTLEMENT_COMPLETED
  GROUP_INVITE
  REMINDER
  MENTION
  SYSTEM
}

model Activity {
  id           String         @id @default(cuid())
  userId       String
  groupId      String?
  expenseId    String?
  settlementId String?
  action       ActivityAction
  details      Json?
  createdAt    DateTime       @default(now())

  user       User        @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)
  group      Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expense    Expense?    @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([groupId])
}

enum ActivityAction {
  GROUP_CREATED
  USER_JOINED
  EXPENSE_ADDED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_MADE
  SETTLEMENT_REVERSED
}

model Receipt {
  id          String        @id @default(cuid())
  groupId     String
  expenseId   String?
  uploaderId  String
  objectKey   String        @unique
  contentType String
  sizeBytes   Int
  status      ReceiptStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expense  Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([expenseId])
}

enum ReceiptStatus {
  PENDING
  READY
  DELETED
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OutboxEvent {
  id        String       @id @default(cuid())
  type      String
  payload   Json
  status    OutboxStatus @default(PENDING)
  error     String?
  attempts  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, createdAt])
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}
